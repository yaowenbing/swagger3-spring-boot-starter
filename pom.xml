<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.worm</groupId>
    <artifactId>swagger3-spring-boot-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>swagger3-spring-boot-starter</name>
    <description>Spring Boot 4 接口文档 Starter：基于 springdoc-openapi 2.x + Knife4j（jakarta），提供 OpenAPI 3 文档、接口分组、Long 精度处理与文档地址启动打印</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 为什么：7 个无源码预置构件的 class 为 major 65，构建/运行 JDK 已切到 21，编译目标需与之对齐 —— 干什么：以 release=21 一次性约束源码级别、字节码目标与 JDK API 签名 -->
        <maven.compiler.release>21</maven.compiler.release>
        <spring-boot.version>4.0.8</spring-boot.version>
        <!-- 为什么：Lombok 1.18.30 发布于 JDK 21 之前，在 JDK 21 的 javac 下注解处理器静默失效；1.18.34 起官方支持 JDK 8~21 全基线 —— 干什么：固定 lombok 版本保证 JDK 8 与 JDK 21 下注解处理均生效 -->
        <lombok.version>1.18.34</lombok.version>
        <!-- 为什么：Knife4j 与 Boot 基线强绑定，Boot 4.0.6 基线（jakarta 命名空间、springdoc 2.x）使用 jakarta 变体坐标，knife4j-openapi3-jakarta-spring-boot-starter 4.5.0 为其 jakarta/springdoc 2.x 系版本 —— 干什么：固定 Knife4j 版本 -->
        <knife4j.version>4.5.0</knife4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 为什么：本项目独立发布，不依赖内部 BOM，直接导入 Spring Boot 官方 BOM 统一管理 spring-boot / jackson / starter-test 等版本 —— 干什么：以 import 方式引入 spring-boot-dependencies -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 为什么：springdoc-openapi 2.x + Knife4j UI 增强需显式引入避免消费侧缺依赖，Boot 4.0.6 基线（jakarta 命名空间）使用 jakarta 变体坐标 —— 干什么：引入 knife4j-openapi3-jakarta-spring-boot-starter -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>
        <!-- 为什么：@Resource 所在的注解 API 需显式声明避免消费侧缺依赖 —— 干什么：引入 jakarta.annotation-api，版本由 spring-boot-dependencies 统一管理 -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!-- 为什么：开源模块刻意无 parent，继承不到构建父的 distributionManagement，裸 mvn deploy 会因缺发布目标失败 —— 干什么：自持一份与 worm-bom-parent 对齐的发布配置（顶层默认 + profile 覆盖） -->
    <distributionManagement>
        <repository>
            <id>nexusReleases</id>
            <name>releases</name>
            <url>http://127.0.0.1:48081/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>nexusSnapshots</id>
            <name>snapshots</name>
            <url>http://127.0.0.1:48081/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <profiles>
        <!-- 为什么：IDEA 全局勾选了 settings-local，POM 内未声明时每次构建都报 profile 不存在 —— 干什么：声明同名 profile 承接本地私服地址 -->
        <profile>
            <id>settings-local</id>
            <distributionManagement>
                <repository>
                    <id>nexusReleases</id>
                    <name>releases</name>
                    <url>http://127.0.0.1:48081/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>nexusSnapshots</id>
                    <name>snapshots</name>
                    <url>http://127.0.0.1:48081/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
        <!-- 为什么：切换到公司内网私服时不应改 POM —— 干什么：以 settings-swcares 覆盖发布地址 -->
        <profile>
            <id>settings-swcares</id>
            <distributionManagement>
                <repository>
                    <id>psi</id>
                    <name>releases</name>
                    <url>http://maven.sw/repository/maven-releases/</url>
                </repository>
                <snapshotRepository>
                    <id>psi</id>
                    <name>snapshots</name>
                    <url>http://maven.sw/repository/maven-snapshots/</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>
